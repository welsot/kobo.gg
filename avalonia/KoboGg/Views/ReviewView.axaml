<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:KoboGg.ViewModels"
             xmlns:m="using:KoboGg.Models"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="780"
             x:Class="KoboGg.Views.ReviewView"
             x:DataType="vm:ReviewViewModel">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20,24">

    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
      <TextBlock Classes="h1" Text="Review"/>
      <TextBlock Classes="subtitle" Text="These books will be sent to your e-reader." />
    </StackPanel>

    <Border Grid.Row="1" IsVisible="{Binding HasError}"
            Background="{StaticResource KoboErrorBgBrush}"
            BorderBrush="{StaticResource KoboErrorBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,10"
            Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource KoboErrorBrush}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
        <Button Grid.Column="1"
                Command="{Binding DismissErrorCommand}"
                Background="Transparent"
                BorderThickness="0"
                Padding="8,4"
                Content="✕"
                Foreground="{StaticResource KoboErrorBrush}"/>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Books}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="m:UploadedBook">
            <Border BorderBrush="{DynamicResource SystemBaseLowColor}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12"
                    Margin="0,0,0,10">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{Binding FileName}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <Button Grid.Row="0" Grid.Column="1"
                        Background="Transparent"
                        BorderThickness="0"
                        MinHeight="0"
                        Padding="6"
                        Command="{Binding $parent[ItemsControl].((vm:ReviewViewModel)DataContext).RemoveBookCommand}"
                        CommandParameter="{Binding}"
                        Content="✕"/>
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Classes="subtitle"
                           FontSize="13"
                           Text="{Binding SizeBytes, StringFormat={}{0:N0} bytes}"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Grid.Row="3" Spacing="10" Margin="0,16,0,0">
      <Button Classes="primary"
              HorizontalAlignment="Stretch"
              Command="{Binding FinalizeCommand}"
              IsEnabled="{Binding CanFinalize}"
              Content="Send to Kobo"/>
      <Button Classes="secondary"
              HorizontalAlignment="Stretch"
              Command="{Binding BackCommand}"
              IsEnabled="{Binding CanGoBack}"
              Content="← Add more"/>
    </StackPanel>
  </Grid>
</UserControl>
